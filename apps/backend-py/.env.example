# ─── Database ────────────────────────────────────────────────────────────────
# Either a URL (SQLAlchemy, libpq or the Spring-style JDBC form are all accepted)...
DB_URL=postgresql://doclift:doclift@localhost:5432/doclift
# DB_URL=jdbc:postgresql://localhost:5432/doclift   # with DB_USERNAME / DB_PASSWORD
# ...or discrete parts (used when DB_URL is unset):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=doclift
# DB_USERNAME=doclift
# DB_PASSWORD=doclift

# ─── Storage ─────────────────────────────────────────────────────────────────
APP_UPLOAD_DIRECTORY=./uploads
APP_MAX_UPLOAD_SIZE_BYTES=10485760
APP_RETENTION_MINUTES=30
APP_CLEANUP_INTERVAL_SECONDS=60

# ─── HTTP ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Runtime ─────────────────────────────────────────────────────────────────
APP_MAX_CONCURRENT_CONVERSIONS=2
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Conversion ──────────────────────────────────────────────────────────────
# faithful: one Word page per PDF page (page breaks, floating images, columns)
# flow:     reflowable document, paragraphs rejoined across pages
APP_LAYOUT_MODE=faithful
