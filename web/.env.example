# ─── Next.js proxy (server-side only, NOT exposed to the browser) ───────────
# URL of the Spring Boot backend that Next.js rewrites /api/* requests to.
# Defaults to http://127.0.0.1:8080 when unset (local dev only).
# Must be set in staging / production deployments.

# 1. Create a new file '.env.local'.
# 2. Copy .env.example and adjust values.
BACKEND_URL=http://127.0.0.1:8080
